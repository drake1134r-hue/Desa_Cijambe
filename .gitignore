# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node/Yarn
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/out/
/build/
/dist/

# Production/deploy
/.vercel
/.netlify
/.firebase

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing
/coverage

# Environment files (ignore local envs but keep examples)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Public uploads (ignore user-uploaded files)
/public/uploads/

# Editors
.vscode/
.idea/

# OS
.DS_Store

# Secrets
*.pem

# TypeScript
*.tsbuildinfo
next-env.d.ts

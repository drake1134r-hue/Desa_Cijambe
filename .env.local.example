# Copy this file to .env.local and fill in your Supabase project settings.
# Contoh format Supabase URL dan service role key:
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Jangan gunakan publishable key (sb_publishable_...) untuk SUPABASE_SERVICE_ROLE_KEY.

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=uploads
NEXTAUTH_SECRET=change-this-to-a-secure-value
